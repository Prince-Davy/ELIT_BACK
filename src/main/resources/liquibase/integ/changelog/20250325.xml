<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1742899948584-2"
               author="tpiotrow">
        <createTable tableName="answer_ia">
            <column name="question"
                    type="VARCHAR(255)">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_answer_ia"/>
            </column>
            <column name="category"
                    type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="answer"
                    type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id"
                    type="BIGINT">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_answer_ia"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1742899948584-3"
               author="tpiotrow">
        <createTable tableName="feedback_ia">
            <column autoIncrement="true"
                    name="id"
                    type="BIGINT">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_feedback_ia"/>
            </column>
            <column name="is_liked"
                    type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="methodology"
                    type="VARCHAR(255)"/>
            <column name="feedback_answer"
                    type="VARCHAR(255)"/>
            <column name="project_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1742899948584-4"
               author="tpiotrow">
        <createTable tableName="result_ia">
            <column autoIncrement="true"
                    name="id"
                    type="BIGINT">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_result_ia"/>
            </column>
            <column name="predicted_methode"
                    type="VARCHAR(255)"/>
            <column name="predicted_probability"
                    type="DOUBLE"/>
            <column name="project_id"
                    type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1742899948584-5"
               author="tpiotrow">
        <addColumn tableName="predictibility_analysis">
            <column name="chosen_methodology"
                    type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>
    <changeSet id="1742899948584-6"
               author="tpiotrow">
        <addColumn tableName="project">
            <column name="form_progress_status"
                    type="INT"/>
        </addColumn>
    </changeSet>
    <changeSet id="1742899948584-7"
               author="tpiotrow">
        <addColumn tableName="form_question">
            <column name="update_question"
                    type="BOOLEAN"/>
        </addColumn>
    </changeSet>
    <changeSet id="1742899948584-8"
               author="tpiotrow">
        <addUniqueConstraint columnNames="predictibility_analysis_id"
                             constraintName="uc_execution_plan_predictibility_analysis"
                             tableName="execution_plan"/>
    </changeSet>
    <changeSet id="1742899948584-9"
               author="tpiotrow">
        <addUniqueConstraint columnNames="project_id"
                             constraintName="uc_feedback_ia_project"
                             tableName="feedback_ia"/>
    </changeSet>
    <changeSet id="1742899948584-10"
               author="tpiotrow">
        <addUniqueConstraint columnNames="user_id"
                             constraintName="uc_feedback_ia_user"
                             tableName="feedback_ia"/>
    </changeSet>
    <changeSet id="1742899948584-11"
               author="tpiotrow">
        <addUniqueConstraint columnNames="user_id"
                             constraintName="uc_opinion_userid"
                             tableName="opinion"/>
    </changeSet>
    <changeSet id="1742899948584-12"
               author="tpiotrow">
        <addUniqueConstraint columnNames="methodology_id"
                             constraintName="uc_predictibility_analysis_methodology"
                             tableName="predictibility_analysis"/>
    </changeSet>
    <changeSet id="1742899948584-13"
               author="tpiotrow">
        <addUniqueConstraint columnNames="multi_criteria_analysis_id"
                             constraintName="uc_predictibility_analysis_multi_criteria_analysis"
                             tableName="predictibility_analysis"/>
    </changeSet>
    <changeSet id="1742899948584-14"
               author="tpiotrow">
        <addUniqueConstraint columnNames="project_id"
                             constraintName="uc_result_ia_project"
                             tableName="result_ia"/>
    </changeSet>
    <changeSet id="1742899948584-15"
               author="tpiotrow">
        <addUniqueConstraint columnNames="user_id"
                             constraintName="uc_vote_userid"
                             tableName="vote"/>
    </changeSet>
    <changeSet id="1742899948584-16"
               author="tpiotrow">
        <addForeignKeyConstraint baseColumnNames="project_id"
                                 baseTableName="answer_ia"
                                 constraintName="FK_ANSWER_IA_ON_PROJECT"
                                 referencedColumnNames="project_id"
                                 referencedTableName="project"/>
    </changeSet>
    <changeSet id="1742899948584-17"
               author="tpiotrow">
        <addForeignKeyConstraint baseColumnNames="project_id"
                                 baseTableName="feedback_ia"
                                 constraintName="FK_FEEDBACK_IA_ON_PROJECT"
                                 referencedColumnNames="project_id"
                                 referencedTableName="project"/>
    </changeSet>
    <changeSet id="1742899948584-18"
               author="tpiotrow">
        <addForeignKeyConstraint baseColumnNames="user_id"
                                 baseTableName="feedback_ia"
                                 constraintName="FK_FEEDBACK_IA_ON_USER"
                                 referencedColumnNames="user_id"
                                 referencedTableName="user"/>
    </changeSet>
    <changeSet id="1742899948584-19"
               author="tpiotrow">
        <addForeignKeyConstraint baseColumnNames="project_id"
                                 baseTableName="result_ia"
                                 constraintName="FK_RESULT_IA_ON_PROJECT"
                                 referencedColumnNames="project_id"
                                 referencedTableName="project"/>
    </changeSet>
    <changeSet id="1742899948584-20"
               author="tpiotrow">
        <dropColumn columnName="user_job"
                    tableName="user"/>
    </changeSet>
    <changeSet id="1742899948584-21"
               author="tpiotrow">
        <modifyDataType columnName="name"
                        newDataType="VARCHAR(255)"
                        tableName="project"/>
    </changeSet>
</databaseChangeLog>
